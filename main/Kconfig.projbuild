menu "I2S to USB Audio"
    # Board / pin configuration lives in components/boards/Kconfig.projbuild.

    menu "I2S Input"

        choice I2S_IN_ROLE
            prompt "I2S role of this chip"
            default I2S_IN_ROLE_SLAVE
            help
                SLAVE: the external audio source (ADC, S/PDIF receiver, another
                MCU, a Raspberry Pi, ...) drives BCK and WS, the ESP32 only
                samples the data line. Use this whenever the source already
                generates the I2S clocks.

                MASTER: the ESP32 generates BCK / WS (and optionally MCLK) and
                the external device (e.g. a PCM1808 ADC) shifts data out in
                response.

            config I2S_IN_ROLE_SLAVE
                bool "Slave (source provides BCK/WS)"
            config I2S_IN_ROLE_MASTER
                bool "Master (ESP32 provides BCK/WS/MCLK)"
        endchoice

        choice I2S_IN_RATE
            prompt "I2S input sample rate"
            default I2S_IN_RATE_48000
            help
                Sample rate of the I2S stream coming in. In slave mode this must
                match what the source actually sends. 48 kHz needs no resampling
                because the USB side runs at 48 kHz. 44.1 kHz is upsampled to
                48 kHz on the fly (costs CPU).

            config I2S_IN_RATE_48000
                bool "48000 Hz (no resampling)"
            config I2S_IN_RATE_44100
                bool "44100 Hz (resampled to 48000 Hz)"
        endchoice

        config I2S_IN_RATE_HZ
            int
            default 44100 if I2S_IN_RATE_44100
            default 48000

        choice I2S_IN_SLOT_BITS
            prompt "I2S slot width"
            default I2S_IN_SLOT_32BIT
            help
                Number of bit-clock cycles per channel slot on the wire.
                Most ADCs / S/PDIF receivers / Raspberry Pi use 32-bit slots
                (even for 16- or 24-bit audio). Pick 16 only if your source
                really sends 16 BCK cycles per channel (BCK = 32 x fs).
                Audio is truncated to 16 bits for the USB stream either way.

            config I2S_IN_SLOT_32BIT
                bool "32-bit slots (BCK = 64 x fs)"
            config I2S_IN_SLOT_16BIT
                bool "16-bit slots (BCK = 32 x fs)"
        endchoice

        config I2S_IN_SLOT_BITS
            int
            default 16 if I2S_IN_SLOT_16BIT
            default 32

        choice I2S_IN_FORMAT
            prompt "I2S data format"
            default I2S_IN_FORMAT_PHILIPS

            config I2S_IN_FORMAT_PHILIPS
                bool "Philips I2S (data delayed 1 BCK after WS edge)"
            config I2S_IN_FORMAT_MSB
                bool "MSB / left-justified (no 1 BCK delay)"
        endchoice

        config I2S_IN_BCK_IO
            int "I2S input bit clock (BCK) GPIO"
            default 4
            range 0 48
            help
                Input pin in slave mode, output pin in master mode.
                Avoid strapping pins (0, 3, 45, 46), the USB pins (19, 20)
                and the flash/PSRAM pins (26-37 depending on module).

        config I2S_IN_WS_IO
            int "I2S input word select (WS / LRCK) GPIO"
            default 5
            range 0 48
            help
                Input pin in slave mode, output pin in master mode.

        config I2S_IN_DIN_IO
            int "I2S input data (DIN / SD) GPIO"
            default 6
            range 0 48
            help
                Serial data coming from the external source.

        config I2S_IN_MCLK_IO
            int "I2S input master clock (MCLK) GPIO (-1 = none)"
            default -1
            range -1 48
            help
                Only used in master mode, for ADCs that need a master clock
                (e.g. PCM1808 needs 256 x fs). Set to -1 if not needed.

    endmenu

    menu "USB Audio Output"

        config OUTPUT_SAMPLE_RATE_HZ
            int "USB audio sample rate (must equal UAC_SAMPLE_RATE)"
            default 48000
            help
                Sample rate presented to the USB host. This must match
                CONFIG_UAC_SAMPLE_RATE of the usb_device_uac component
                (sdkconfig.defaults.esp32s3 sets both to 48000).

        config USB_AUDIO_BUFFER_MS
            int "USB ring buffer size (ms)"
            default 60
            range 20 500
            help
                Size of the buffer between the I2S capture task and the USB
                isochronous endpoint. It absorbs scheduling jitter and the slow
                clock drift between the I2S source and the USB host. Larger
                values tolerate more jitter but add latency.

        config USB_AUDIO_PRIME_MS
            int "USB prefill before streaming starts (ms)"
            default 20
            range 5 250
            help
                Amount of audio that must be buffered before data is handed to
                the USB host (after start-up or after an underrun). Must be
                smaller than the buffer size. This is roughly the steady-state
                latency added by the buffer.

    endmenu

    config RESAMPLER_TAPS
        int "Resampler filter taps (quality)" if I2S_IN_RATE_44100
        range 4 64
        default 28 if IDF_TARGET_ESP32S3
        default 12 if IDF_TARGET_ESP32
        default 16
        help
            Number of taps for the sinc resampler filters (only used when the
            I2S input is 44.1 kHz). Must be a multiple of 4.
            ESP32-S3 (hardware FPU): 28 recommended.

endmenu
