# ESP32-S3 target defaults - default to ESP32-S3 Generic board
CONFIG_BOARD_ESP32S3_GENERIC=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM_MODE_OCT=y

# USB Audio Class defaults for the usb_device_uac integration.
# Keep both streams stereo at 48 kHz.  CONFIG_OUTPUT_SAMPLE_RATE_HZ (main
# component) must equal CONFIG_UAC_SAMPLE_RATE.
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=2
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_OUTPUT_SAMPLE_RATE_HZ=48000

# I2S input (see main/Kconfig.projbuild for all options)
#   Slave mode: the external source drives BCK and WS.
#   Wiring (ESP32-S3):  source BCK -> GPIO4, source WS/LRCK -> GPIO5,
#                       source data -> GPIO6, common GND.
CONFIG_I2S_IN_ROLE_SLAVE=y
CONFIG_I2S_IN_RATE_48000=y
CONFIG_I2S_IN_SLOT_32BIT=y
CONFIG_I2S_IN_FORMAT_PHILIPS=y
CONFIG_I2S_IN_BCK_IO=4
CONFIG_I2S_IN_WS_IO=5
CONFIG_I2S_IN_DIN_IO=6
CONFIG_I2S_IN_MCLK_IO=-1

