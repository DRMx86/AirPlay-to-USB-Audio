# ESP32-S3 target defaults - default to ESP32-S3 Generic board
CONFIG_BOARD_ESP32S3_GENERIC=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM_MODE_OCT=y

# USB DAC output (ESP32-S3 is the USB host; UAC 1.0 and 2.0 dongles).
# Radio streams at other rates (usually 44.1 kHz) are resampled to this rate.
CONFIG_OUTPUT_SAMPLE_RATE_HZ=48000
# GPIO that enables 5 V on the USB host VBUS, -1 if the board powers it itself.
CONFIG_USB_HOST_VBUS_EN_GPIO=-1

# Wi-Fi credentials. Prefer setting these in menuconfig or in your own
# (git-ignored) sdkconfig rather than committing them here.
# CONFIG_RADIO_WIFI_SSID="my-network"
# CONFIG_RADIO_WIFI_PASSWORD="my-password"
